        {
          "name": "quantity",
          "type": "DECIMAL(10,2)",
          "nullable": true,
          "key": null,
          "description": "Quantity sold (in Menu_Items.unit_of_measure).",
          "allowed_values": "> 0"
        },
        {
          "name": "unit_price",
          "type": "DECIMAL(10,2)",
          "nullable": true,
          "key": null,
          "description": "Actual selling price at order time (from Pricing_History).",
          "allowed_values": "> 0"
        },
        {
          "name": "unit_cost",
          "type": "DECIMAL(10,2)",
          "nullable": true,
          "key": null,
          "description": "Actual cost at order time.",
          "allowed_values": "> 0"
        },
        {
          "name": "discount_amount",
          "type": "DECIMAL(12,2)",
          "nullable": true,
          "key": null,
          "description": "Discount applied to this line.",
          "allowed_values": ">= 0"
        },
        {
          "name": "line_total",
          "type": "DECIMAL(12,2)",
          "nullable": true,
          "key": null,
          "description": "quantity * unit_price - discount_amount.",
          "allowed_values": "Any decimal (raw may include anomalies)"
